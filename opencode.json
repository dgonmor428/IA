{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "instructions": [
    "constitution.md"
  ],
  "permission": {
    "bash": {
      "": "ask",
      "git status": "allow",
      "git status --short": "allow",
      "git diff": "allow",
      "git diff --cached": "allow",
      "git branch --show-current": "allow",
      "git log --oneline": "allow",
      "git rev-parse HEAD": "allow",
      "gh pr list": "allow",
      "gh pr view": "allow",
      "gh auth status": "allow",
      "git push --force": "deny",
      "git push -f": "deny",
      "git push +": "deny",
      "git reset --hard": "deny",
      "git clean": "deny",
      "gh pr merge --admin": "deny",
      "gh pr merge --auto": "deny",
      "gh auth token": "deny"
    },
    "edit": "ask",
    "task": "deny",
    "external_directory": "ask"
  }
}
